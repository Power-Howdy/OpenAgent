# Paid providers. The first one that is set selects that provider.
# With none of these, OpenAgent uses free mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1

# Free mode. Important threaded work uses NVIDIA NIM.
# Bookkeeping calls use the local Qwen3-0.6B server as a new chat.
# NVIDIA_API_KEY, or: openagent config set -g nvidiaApiKey <key>
NVIDIA_API_KEY=
OPENAGENT_PROVIDER=
OPENAGENT_MODEL=
OPENAGENT_BASE_URL=
OPENAGENT_LOCAL_BASE_URL=http://127.0.0.1:8080/v1
OPENAGENT_LOCAL_CTX=4096
OPENAGENT_LOCAL_GGUF=/home/severus/Documents/llm_playground/gguf_models/Qwen3-0.6B-Q4_K_M-imat.gguf
OPENAGENT_LLAMA_SERVER=/home/severus/Documents/llm_playground/llama.cpp/build/bin/llama-server
